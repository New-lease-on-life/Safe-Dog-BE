      "title": "SafeDog Target Up",
      "datasource": {
        "type": "prometheus",
        "uid": "ffgd27k9hjq4gb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(up{job=\"safedog-be\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
